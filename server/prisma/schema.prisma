// QFree — database schema (PostgreSQL, Prisma 7)
// Core flow: Patient -> QueueEntry -> Queue -> Provider (Doctor / Service @ Organization)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  ORG_ADMIN
  ADMIN
}

enum OrganizationType {
  CLINIC
  LABORATORY
  HOSPITAL
  DIAGNOSTIC_CENTER
}

enum StaffRole {
  OWNER
  MANAGER
  RECEPTIONIST
}

enum ServiceCategory {
  CONSULTATION
  LAB_TEST
  DIAGNOSTIC
  PROCEDURE
  OTHER
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum EntryStatus {
  WAITING
  SERVING
  COMPLETED
  SKIPPED
  CANCELLED
  NO_SHOW
}

enum Priority {
  NORMAL
  PRIORITY // elderly, pregnant, disabled — set by staff only
  EMERGENCY // set by staff only, always served next
}

enum QueueEventType {
  OPENED
  PAUSED
  RESUMED
  CLOSED
  JOINED
  CALLED
  COMPLETED
  SKIPPED
  REQUEUED
  CANCELLED
  NO_SHOW
  PRIORITY_CHANGED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         Role      @default(PATIENT)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  patient       Patient?
  doctor        Doctor?
  memberships   StaffMember[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  issues        Issue[]        @relation("IssueReporter")
  queueEvents   QueueEvent[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Minimal patient data by design: no diagnosis or medical records are stored.
model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  queueEntries QueueEntry[]
  appointments Appointment[]

  @@map("patients")
}

// ───────────────────────────── Providers ─────────────────────────────

/// Clinics, laboratories, hospitals and diagnostic centers share one table,
/// discriminated by `type` (avoids duplicate clinic/laboratory tables).
model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  type        OrganizationType
  description String?
  address     String
  city        String
  phone       String?
  email       String?
  timezone    String           @default("Asia/Kolkata")
  isVerified  Boolean          @default(false) @map("is_verified")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  hours        OperatingHours[]
  staff        StaffMember[]
  doctors      Doctor[]
  services     Service[]
  queues       Queue[]
  appointments Appointment[]

  @@index([type])
  @@index([city])
  @@map("organizations")
}

model StaffMember {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  staffRole      StaffRole @default(RECEPTIONIST) @map("staff_role")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("staff_members")
}

/// Weekly opening hours, local time of the organization's timezone ("HH:MM").
model OperatingHours {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week") // 0 = Sunday … 6 = Saturday
  openTime       String  @map("open_time")
  closeTime      String  @map("close_time")
  isClosed       Boolean @default(false) @map("is_closed")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek])
  @@map("operating_hours")
}

model Doctor {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  organizationId      String?  @map("organization_id") @db.Uuid
  specialization      String
  qualification       String?
  experienceYears     Int      @default(0) @map("experience_years")
  bio                 String?
  consultationMinutes Int      @default(10) @map("consultation_minutes")
  isAvailable         Boolean  @default(true) @map("is_available")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  schedules    DoctorSchedule[]
  queues       Queue[]
  appointments Appointment[]

  @@index([organizationId])
  @@index([specialization])
  @@map("doctors")
}

model DoctorSchedule {
  id        String @id @default(uuid()) @db.Uuid
  doctorId  String @map("doctor_id") @db.Uuid
  dayOfWeek Int    @map("day_of_week")
  startTime String @map("start_time")
  endTime   String @map("end_time")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("doctor_schedules")
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  category        ServiceCategory
  description     String?
  durationMinutes Int             @default(10) @map("duration_minutes")
  price           Decimal?        @db.Decimal(10, 2)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues       Queue[]

  @@unique([organizationId, name])
  @@map("services")
}

// ───────────────────────────── Queues ─────────────────────────────

/// A queue serves one doctor and/or one service at an organization.
/// Tokens restart every session day (`sessionDate`, organization-local).
model Queue {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  doctorId             String?     @map("doctor_id") @db.Uuid
  serviceId            String?     @map("service_id") @db.Uuid
  name                 String
  tokenPrefix          String      @default("QF") @map("token_prefix")
  status               QueueStatus @default(CLOSED)
  capacity             Int         @default(100)
  sessionDate          String?     @map("session_date") // YYYY-MM-DD in org timezone
  lastTokenNumber      Int         @default(0) @map("last_token_number")
  avgServiceSeconds    Int         @default(600) @map("avg_service_seconds") // EWMA
  approachingThreshold Int         @default(3) @map("approaching_threshold")
  openedAt             DateTime?   @map("opened_at")
  pausedAt             DateTime?   @map("paused_at")
  closedAt             DateTime?   @map("closed_at")
  isArchived           Boolean     @default(false) @map("is_archived")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctor       Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  entries      QueueEntry[]
  events       QueueEvent[]

  @@index([organizationId])
  @@index([doctorId])
  @@index([status])
  @@map("queues")
}

model QueueEntry {
  id                  String      @id @default(uuid()) @db.Uuid
  queueId             String      @map("queue_id") @db.Uuid
  patientId           String      @map("patient_id") @db.Uuid
  sessionDate         String      @map("session_date")
  tokenNumber         Int         @map("token_number")
  tokenLabel          String      @map("token_label")
  status              EntryStatus @default(WAITING)
  priority            Priority    @default(NORMAL)
  /// Ordering key inside a priority band (smaller = earlier). Spaced by 1000 so
  /// skipped patients can be re-inserted between others without renumbering.
  sortKey             Int         @map("sort_key")
  skipCount           Int         @default(0) @map("skip_count")
  approachingNotified Boolean     @default(false) @map("approaching_notified")
  note                String?
  joinedAt            DateTime    @default(now()) @map("joined_at")
  calledAt            DateTime?   @map("called_at")
  completedAt         DateTime?   @map("completed_at")
  cancelledAt         DateTime?   @map("cancelled_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  queue       Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  events      QueueEvent[]
  appointment Appointment?

  // One-active-entry-per-patient-per-queue is enforced by a partial unique
  // index created in the migration (status IN ('WAITING','SERVING')).
  @@unique([queueId, sessionDate, tokenNumber])
  @@index([queueId, status, priority, sortKey])
  @@index([patientId, joinedAt])
  @@index([queueId, sessionDate])
  @@map("queue_entries")
}

/// Append-only log of every queue transaction (full history).
model QueueEvent {
  id        String         @id @default(uuid()) @db.Uuid
  queueId   String         @map("queue_id") @db.Uuid
  entryId   String?        @map("entry_id") @db.Uuid
  actorId   String?        @map("actor_id") @db.Uuid
  type      QueueEventType
  meta      Json?
  createdAt DateTime       @default(now()) @map("created_at")

  queue Queue       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  entry QueueEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  actor User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([queueId, createdAt])
  @@index([entryId])
  @@map("queue_events")
}

/// Future: scheduled bookings. Linked to a queue entry once checked in.
model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  doctorId       String?           @map("doctor_id") @db.Uuid
  queueEntryId   String?           @unique @map("queue_entry_id") @db.Uuid
  scheduledAt    DateTime          @map("scheduled_at")
  status         AppointmentStatus @default(BOOKED)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctor       Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  queueEntry   QueueEntry?  @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)

  @@index([patientId, scheduledAt])
  @@map("appointments")
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Issue {
  id          String      @id @default(uuid()) @db.Uuid
  reporterId  String      @map("reporter_id") @db.Uuid
  subject     String
  description String
  status      IssueStatus @default(OPEN)
  adminNote   String?     @map("admin_note")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  reporter User @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("issues")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
